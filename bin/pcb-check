#!/usr/bin/env bash
# pcb-check — one-shot verify loop for a KiCad 9 project.
#
#   pcb-check [PROJECT_DIR] [--fab] [--render]
#
# Writes everything to PROJECT_DIR/out/check/:
#   erc.json, drc.json         machine-readable reports (DRC incl. schematic parity)
#   schematic-N.png            schematic pages as images
#   layer-<name>.png           each copper layer + board outline
#   top.png / bottom.png       assembly-style composites
#   render-top/bottom.png      3D raytraced renders           (--render)
#   ../fab/                    JLCPCB gerbers, BOM, CPL via kikit (--fab)
#
# Exit code: 0 clean, 1 ERC/DRC violations or failed --fab, 2 usage/setup error.
# Meant to be run by Claude Code after every schematic or layout change.
set -uo pipefail

DIR="."; FAB=0; RENDER=0
for a in "$@"; do
  case "$a" in
    --fab) FAB=1 ;;
    --render) RENDER=1 ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    *) DIR="$a" ;;
  esac
done

[ -f "$DIR" ] && DIR="$(dirname "$DIR")"
cd "$DIR" || { echo "pcb-check: no such dir $DIR" >&2; exit 2; }

PRO=$(ls *.kicad_pro 2>/dev/null | head -1)
[ -n "$PRO" ] || { echo "pcb-check: no .kicad_pro in $(pwd)" >&2; exit 2; }
NAME="${PRO%.kicad_pro}"
SCH="$NAME.kicad_sch"; PCB="$NAME.kicad_pcb"
OUT="out/check"; rm -rf "$OUT"; mkdir -p "$OUT"
FAIL=0

# ---- ERC ----
if [ -f "$SCH" ]; then
  kicad-cli sch erc --format json --severity-all -o "$OUT/erc.json" "$SCH" >/dev/null 2>&1
  n=$(jq '[.sheets[].violations[] | select(.severity=="error")] | length' "$OUT/erc.json" 2>/dev/null || echo "?")
  w=$(jq '[.sheets[].violations[] | select(.severity=="warning")] | length' "$OUT/erc.json" 2>/dev/null || echo "?")
  echo "ERC: $n errors, $w warnings"
  [ "$n" = "0" ] || FAIL=1
  kicad-cli sch export pdf -o "$OUT/schematic.pdf" "$SCH" >/dev/null 2>&1 \
    && pdftoppm -png -r 110 "$OUT/schematic.pdf" "$OUT/schematic"
fi

# ---- DRC (with schematic parity) ----
if [ -f "$PCB" ]; then
  parity=""; [ -f "$SCH" ] && parity="--schematic-parity"
  kicad-cli pcb drc $parity --format json --severity-all -o "$OUT/drc.json" "$PCB" >/dev/null 2>&1
  e=$(jq '[.violations[] | select(.severity=="error")] | length' "$OUT/drc.json" 2>/dev/null || echo "?")
  u=$(jq '.unconnected_items | length' "$OUT/drc.json" 2>/dev/null || echo "?")
  p=$(jq '.schematic_parity | length' "$OUT/drc.json" 2>/dev/null || echo "?")
  echo "DRC: $e errors, $u unconnected, $p parity issues"
  { [ "$e" = "0" ] && [ "$u" = "0" ] && [ "$p" = "0" ]; } || FAIL=1

  # ---- Layer images (board area only, white background) ----
  svg() { # $1 = output stem, $2 = layer list
    kicad-cli pcb export svg --layers "$2" --page-size-mode 2 --exclude-drawing-sheet \
      -o "$OUT/$1.svg" "$PCB" >/dev/null 2>&1 \
      && rsvg-convert -w 2000 -b white "$OUT/$1.svg" -o "$OUT/$1.png" \
      && rm -f "$OUT/$1.svg"
  }
  for L in F.Cu In1.Cu In2.Cu In3.Cu In4.Cu B.Cu; do
    grep -q "\"$L\"" "$PCB" && svg "layer-${L%.Cu}" "$L,Edge.Cuts"
  done
  svg top    "F.Cu,F.Silkscreen,F.Fab,Edge.Cuts"
  svg bottom "B.Cu,B.Silkscreen,B.Fab,Edge.Cuts"

  if [ "$RENDER" = 1 ]; then
    for s in top bottom; do
      xvfb-run -a kicad-cli pcb render --side "$s" --quality high -w 1600 -h 1200 \
        -o "$OUT/render-$s.png" "$PCB" >/dev/null 2>&1 || echo "render $s failed"
    done
  fi

  if [ "$FAB" = 1 ]; then
    rm -rf out/fab
    # kikit/wx print noisy debug lines on stderr; keep them in a log, show only on failure.
    if kikit fab jlcpcb --assembly --field LCSC --schematic "$SCH" --no-drc "$PCB" out/fab >"$OUT/kikit.log" 2>&1; then
      echo "FAB: out/fab (gerbers, bom.csv, pos.csv)"
    else
      echo "FAB: failed, see $OUT/kikit.log"; grep -v "Debug:" "$OUT/kikit.log" | tail -5
      FAIL=1
    fi
  fi
fi

echo "Images + reports: $(pwd)/$OUT"
exit $FAIL
